# Copy this file to ~/.gitconfig.local and fill in your details
# cp ~/.gitconfig.local.template ~/.gitconfig.local
# chmod 600 ~/.gitconfig.local
#
# Everything machine-specific goes here. The signing policy itself
# (gpg.format, commit.gpgsign) lives in the tracked .gitconfig — only the key,
# the allowed-signers file and the credential helper differ per machine. Don't
# repeat the policy keys here; one source per key.
#
# .gitconfig includes this file last, so anything set here overrides the tracked
# config — that is the point of this file. Use it when a machine has to deviate.

[user]
    name = Kobe
    email = 81110+Kobe@users.noreply.github.com
    signingkey = ~/.ssh/your_signing_key.pub

[gpg "ssh"]
    allowedSignersFile = ~/.ssh/allowed_signers

[tag]
    gpgsign = true

# Written by `gh auth setup-git` — re-run that rather than editing by hand.
[credential "https://github.com"]
    helper =
    helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
    helper =
    helper = !/opt/homebrew/bin/gh auth git-credential
